# Google Gemini API key for Somali script and scene prompt generation.
# Get a free key at https://aistudio.google.com/apikey
# Without this set, script generation falls back to the offline templates
# (only Agriculture, Security, FinTech, and Language topics have real content).
GEMINI_API_KEY=

# Optional: override the Gemini model used for script generation.
# Defaults to gemini-3.6-flash (fast, high quality, active tier).
# GEMINI_MODEL=gemini-3.6-flash

# Optional: override the Gemini image-generation model used for AI scene
# visuals. Uses the same GEMINI_API_KEY above (generateContent with an
# image-capable model, NOT the Imagen/Vertex-only generateImages API, which
# does not work with a plain Gemini Developer API key from AI Studio).
# Note: image generation typically requires a billing-enabled (prepay) API
# project, unlike text generation's free tier. Without a working image
# model, scenes automatically fall back to the offline SVG visual card, so
# this never breaks reel generation.
# Defaults to gemini-3-pro-image-preview (falls back to gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# OpenAI API key, used as the SECOND image provider. Optional, but without it
# a depleted Gemini balance means every scene falls back to the offline SVG
# placeholder instead of a real cinematic visual. Gemini is still tried first
# (it renders 9:16 natively and has a free tier); OpenAI only runs when Gemini
# cannot produce an image. Get a key at https://platform.openai.com/api-keys —
# note that a ChatGPT subscription does NOT include API access.
OPENAI_API_KEY=

# Optional: override the OpenAI image model. Defaults to gpt-image-1-mini,
# the cheapest (~$0.006/image at low quality, so ~4 US cents per 6-scene reel).
# OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Optional: OpenAI image quality — low (default), medium, or high. Raising it
# increases cost per image roughly 10x per step; low is usually enough because
# the render is downscaled into a 1080x1920 frame anyway.
# OPENAI_IMAGE_QUALITY=low

