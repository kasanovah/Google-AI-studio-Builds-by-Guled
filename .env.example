# Google Gemini API key for Somali script and scene prompt generation.
# Get a free key at https://aistudio.google.com/apikey
# Without this set, script generation falls back to the offline templates
# (only Agriculture, Security, FinTech, and Language topics have real content).
GEMINI_API_KEY=

# Optional: override the Gemini model used for script generation.
# Defaults to gemini-2.5-flash (stable, fast, generous free tier).
# GEMINI_MODEL=gemini-2.5-flash
