    "firebase": "^12.18.0",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
